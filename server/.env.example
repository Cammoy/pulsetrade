# ── Live trading (optional — leave unset to run in paper mode) ──────────────
# 0x Swap API key — https://0x.org/docs (free tier works)
ZEROX_API_KEY=

# Private key of a DEDICATED bot wallet. Fund it only with what the bot may trade.
# Never use your main wallet key.
BOT_WALLET_KEY=

# Dedicated EVM RPC endpoints, PER CHAIN (Alchemy/Infura/etc). STRONGLY RECOMMENDED
# for LIVE EVM trading — viem's default public RPC is rate-limited and unreliable
# under load. Set one for EACH chain you trade live; unset chains use the public
# default. They run concurrently, so a single shared URL would point the others at
# the wrong node. Chain IDs: Base 8453, Arbitrum 42161, Optimism 10, Polygon 137, BNB 56.
#
# MEV PROTECTION (P2-1): point these at a PRIVATE/PROTECTED relay (e.g. Flashbots Protect,
# MEV Blocker, or your provider's protected endpoint) so swaps don't broadcast to the public
# mempool where sandwich bots front-run them. The engine sends through whatever URL you set
# here — no code change needed. (Modeled MEV/slippage cost is already in the backtest cost
# model; per-pool tightening via MAX_SLIPPAGE_BPS + the price-impact guard.) Solana Jito-bundle
# submission is NOT yet implemented — use a low-latency SOLANA_RPC_URL and tight slippage.
EVM_RPC_URL_8453=
EVM_RPC_URL_42161=
EVM_RPC_URL_10=
EVM_RPC_URL_137=
EVM_RPC_URL_56=
# Hard-block arming live unless a dedicated RPC is set for each ready chain (P2-11). Default
# off (advisory warning only — public RPCs work, just rate-limited).
# REQUIRE_DEDICATED_RPC=true

# ── Turnkey signing (optional, RECOMMENDED over a raw key) ────────────────────
# Sign live trades with a Turnkey wallet — the spending key lives in Turnkey's
# secure infra and signing goes through their API + Policies, so no raw private
# key sits here. Set these INSTEAD of BOT_WALLET_KEY / SOLANA_WALLET_KEY. The API
# private key is an API credential, NOT a spending key. https://app.turnkey.com
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
# Wallet-account address to sign with (from your Turnkey wallet) per chain family:
TURNKEY_EVM_ADDRESS=
TURNKEY_SOLANA_ADDRESS=
# Optional API base (default https://api.turnkey.com)
TURNKEY_API_BASE_URL=

# ── Live safety: daily spend cap (optional, RECOMMENDED) ──────────────────────
# Max USD the bots may SPEND on live BUYS per day (0 / unset = unlimited). A buy
# that would exceed it is skipped (the bot keeps running and resumes next day).
# Turnkey Policies are stateless per-signature, so this cumulative cap is enforced
# by the engine; pair it with a per-transaction value cap in a Turnkey Policy.
MAX_LIVE_USD_PER_DAY=50

# Account circuit breaker (0 = off). Unlike the daily cap, a trip PAUSES ALL BOTS
# and stays tripped until you manually re-arm (it does NOT reset at midnight).
# MAX_CUMULATIVE_LOSS_USD: stop after this much realized live loss accrues.
# MAX_LIVE_USD_TOTAL: hard ceiling on total live $ ever deployed (lifetime, until re-arm).
# MAX_FLEET_DRAWDOWN_PCT: trailing-equity drawdown stop — trips if the live fleet's
#   mark-to-market value (cash + open positions + banked profit) falls this % below its
#   high-water mark. Catches UNREALIZED bleed the realized-loss cap misses. 0 = off.
MAX_CUMULATIVE_LOSS_USD=30
MAX_LIVE_USD_TOTAL=150
# MAX_FLEET_DRAWDOWN_PCT=25

# Exposure caps (0 = off), sized as a % of MAX_LIVE_USD_TOTAL (the lifetime ceiling),
# so they bound real funds from the very first bot. STRONGLY recommended for live.
# MAX_SNIPE_EQUITY_PCT: a single snipe may stake at most this % of the lifetime ceiling
#   — one rugged minutes-old token then can't take out the whole account.
# MAX_TOKEN_EXPOSURE_PCT: total exposure to ANY one token, summed across all live bots
#   sharing the wallet, may not exceed this % — a concentration cap.
MAX_SNIPE_EQUITY_PCT=25
MAX_TOKEN_EXPOSURE_PCT=40

# 0x router pin (drain protection). The v2 allowance-holder AllowanceHolder is the same
# deterministic address on every chain we trade; we approve + send only to it and approve
# only the exact trade amount. ONLY set this if 0x redeploys — it EXTENDS the built-in
# pin (comma-separated). Leave unset otherwise.
# ZEROX_ALLOWANCE_HOLDER=

# ── Market data (optional, recommended) ──────────────────────────────────────
# CoinGecko API key — the free "Demo" key raises the rate limit ~3-15× and largely
# eliminates the 429 backoff that briefly leaves prices/holdings unpriced ("pricing…").
# Get a free demo key at https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# Set to true only if COINGECKO_API_KEY is a PAID (Pro) key (uses pro-api.coingecko.com).
# COINGECKO_PRO=false

# ── AI trading (optional) ────────────────────────────────────────────────────
# Google Gemini API key — enables the AI Trader strategy (Gemini decides
# buy/sell/hold). Free tier covers this usage. https://aistudio.google.com
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash)
GEMINI_MODEL=

# ── Smart-money wallet tracking (optional) ───────────────────────────────────
# Etherscan API key (V2 multichain, one key all chains) — enables the smart-money
# activity feed and copy-trade bots. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ── Solana live trading (optional) ───────────────────────────────────────────
# Base58 secret key of a DEDICATED Solana bot wallet. Swaps route via Jupiter.
# Fund it only with what the bot may trade. Never use your main wallet key.
SOLANA_WALLET_KEY=
# Optional custom RPC (default https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=

# ── Internet Computer (read-only) ────────────────────────────────────────────
# Optional IC gateway for reading ICP / ckBTC / ckUSDT balances in the portfolio
# view (default https://icp-api.io). No key needed — balance queries are anonymous.
ICP_GATEWAY_URL=

# Engine port (default 8787)
ENGINE_PORT=

# Auto-resume LIVE mode on engine restart (default false = boot into paper for
# safety; re-arm live manually). Set true only for an intentional 24/7 live setup.
RESUME_LIVE_ON_BOOT=false

# Max price impact % to allow on a live BUY/entry (default 10). Protects against
# buying into a thin/manipulated pool where the quote bakes in a huge impact.
# Exits (sells) ignore this so a position can always be liquidated.
MAX_PRICE_IMPACT_PCT=10

# Native gas reserve kept in the bot wallet, as a multiple of the chain's average
# gas cost (default 3 ≈ approve + swap + margin). A live BUY that would leave less
# than this is refused, so a bot can always afford the gas to SELL out. On these
# cheap L2s the reserve is a few cents; raise it if you trade on pricier chains.
GAS_RESERVE_MULT=3

# Max execution slippage in basis points for live swaps (default 100 = 1%, both 0x
# and Jupiter). Tighten (e.g. 30 = 0.3%) on deep major pairs to give up less to
# slippage/MEV; loosen on thin pools so exits don't revert. Applies to buys + sells.
MAX_SLIPPAGE_BPS=100

# ── Alerting (optional, recommended for unattended live) ──────────────────────
# A single outbound notification fires on the events a live operator must not miss:
# a bot halted, the circuit breaker tripped, the tick loop stalled, an untrusted
# ledger, and engine start/shutdown. Configure EITHER a generic JSON webhook and/or
# Telegram. Unset = no alerts (GET /health still works as a poll-based check).
# ALERT_WEBHOOK_URL=https://hooks.example.com/...
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
