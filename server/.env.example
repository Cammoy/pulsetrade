# ── Live trading (optional — leave unset to run in paper mode) ──────────────
# 0x Swap API key — https://0x.org/docs (free tier works)
ZEROX_API_KEY=

# Private key of a DEDICATED bot wallet. Fund it only with what the bot may trade.
# Never use your main wallet key.
BOT_WALLET_KEY=

# ── AI trading (optional) ────────────────────────────────────────────────────
# Google Gemini API key — enables the AI Trader strategy (Gemini decides
# buy/sell/hold). Free tier covers this usage. https://aistudio.google.com
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash)
GEMINI_MODEL=

# ── Smart-money wallet tracking (optional) ───────────────────────────────────
# Etherscan API key (V2 multichain, one key all chains) — enables the smart-money
# activity feed and copy-trade bots. https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ── Solana live trading (optional) ───────────────────────────────────────────
# Base58 secret key of a DEDICATED Solana bot wallet. Swaps route via Jupiter.
# Fund it only with what the bot may trade. Never use your main wallet key.
SOLANA_WALLET_KEY=
# Optional custom RPC (default https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=

# Engine port (default 8787)
ENGINE_PORT=
